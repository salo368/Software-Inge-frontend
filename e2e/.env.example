# Copy to `e2e/.env` and fill in. `playwright.config.ts` auto-loads
# this file. In CI these come from GitHub vars (see
# .github/workflows/e2e.yml).

# CloudFront root of the deployed frontend. Portal lives at ${FRONTEND_BASE_URL}/portal/.
FRONTEND_BASE_URL=https://d1234567890abc.cloudfront.net

# Backend HTTP API URLs, one per service:
#
#   for svc in auth banks forms files processes; do
#     echo -n "$svc: "
#     aws cloudformation describe-stacks --stack-name cdts-dev-$svc \
#       --query "Stacks[0].Outputs[?OutputKey=='HttpApiUrl'].OutputValue" --output text
#   done
AUTH_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
BANKS_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
FORMS_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
FILES_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
PROCESSES_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# Optional: absolute path to a real face JPEG (eyes open, single person).
# When unset the E2E skips the face-validation happy path.
# SIGNATURES_TEST_FACE_PATH=/absolute/path/to/face.jpg
